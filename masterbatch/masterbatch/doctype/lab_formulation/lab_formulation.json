{
  "name": "Lab Formulation",
  "module": "Masterbatch",
  "doctype": "DocType",
  "autoname": "field:formulation_no",
  "is_submittable": 1,
  "title_field": "finished_item",
  "fields": [
    {
      "fieldname": "formulation_no",
      "fieldtype": "Data",
      "label": "Formulation No",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "shade_code",
      "fieldtype": "Link",
      "label": "Shade Code",
      "options": "Shade Code",
      "in_list_view": 1
    },
    {
      "fieldname": "finished_item",
      "fieldtype": "Link",
      "label": "Finished Item",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nApproved",
      "default": "Draft",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "date",
      "fieldtype": "Date",
      "label": "Date"
    },
    {
      "fieldname": "batch_size_kg",
      "fieldtype": "Float",
      "label": "Batch Size (KG)",
      "default": "100"
    },
    {
      "fieldname": "formulation_items",
      "fieldtype": "Table",
      "label": "Formulation Items",
      "options": "Lab Formulation Item"
    },
    {
      "fieldname": "bom",
      "fieldtype": "Link",
      "label": "Production BOM",
      "options": "BOM",
      "read_only": 1
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "Remarks"
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Approved By",
      "options": "User"
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Lab Formulation",
      "no_copy": 1,
      "print_hide": 1,
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    }
  ]
}
